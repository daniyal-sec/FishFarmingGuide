{
	"name": "9. Expense Management",
	"item": [
		{
			"name": "Log New Expense",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"pondId\": 51,\n    \"category\": \"Labor\",\n    \"amount\": 5000.00,\n    \"description\": \"Cleaning and netting for Pond 51\"\n}"
				},
				"url": "http://localhost:5000/api/expenses/add",
				"description": "Records a specific expense tied to a pond (Feed, Labor, etc.)."
			}
		},
		{
			"name": "Get Farm Expense Summary",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Summary contains GrandTotal\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.overall).to.have.property('GrandTotal');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
				],
				"url": "http://localhost:5000/api/expenses/summary/total",
				"description": "CRITICAL: Powers the 'Total Expenses' orange card on the main dashboard."
			}
		},
		{
			"name": "Get Expenses by Pond",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
				],
				"url": "http://localhost:5000/api/expenses/:pondId",
				"variable": [
					{ "key": "pondId", "value": "51" }
				],
				"description": "Lists all expenses for a specific pond for the 'Recent Activity' or pond details view."
			}
		},
		{
			"name": "Update Expense",
			"request": {
				"method": "PUT",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"category\": \"Electricity\",\n    \"amount\": 12500.50,\n    \"description\": \"Updated utility bill\"\n}"
				},
				"url": "http://localhost:5000/api/expenses/:expenseId",
				"variable": [
					{ "key": "expenseId", "value": "1" }
				]
			}
		},
		{
			"name": "Delete Expense Record",
			"request": {
				"method": "DELETE",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
				],
				"url": "http://localhost:5000/api/expenses/:expenseId",
				"variable": [
					{ "key": "expenseId", "value": "1" }
				],
				"description": "Permanently deletes an expense record from the Expense_log table."
			}
		}
	]
},{
    "name": "10. Feed Management",
    "item": [
        {
            "name": "Get Feed Recommendation",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" }
                ],
                "url": "http://localhost:5000/api/feed/recommendation/1",
                "description": "Calculates biomass based on fish size (L) and Condition Factor (K), then recommends daily feed quantity."
            }
        },
        {
            "name": "Log Feeding Activity",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"pondId\": 1,\n    \"speciesId\": 2,\n    \"feedType\": \"Floating Pellets (3mm)\",\n    \"quantity\": 12.5,\n    \"cost\": 2500.00\n}"
                },
                "url": "http://localhost:5000/api/feed/log"
            }
        },
        {
            "name": "Get Pond Feed History",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" }
                ],
                "url": "http://localhost:5000/api/feed/history/1"
            }
        },
        {
            "name": "Update Feeding Log",
            "request": {
                "method": "PUT",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
