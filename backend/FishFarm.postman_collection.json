                "url": "http://localhost:5000/api/inventory/1"
            }
        },
        {
            "name": "Get Dashboard Summary",
            "request": {
                "method": "GET",
                "header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
                "url": "http://localhost:5000/api/inventory/dashboard-summary"
            }
        },
        {
            "name": "Update Inventory",
            "request": {
                "method": "PUT",
                "header": [
                    {"key": "Authorization", "value": "Bearer {{auth_token}}"},
                    {"key": "Content-Type", "value": "application/json"}
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"quantity\": 5500,\n    \"weight\": 2.0,\n    \"cost\": 12.50\n}"
                },
                "url": "http://localhost:5000/api/inventory/1"
            }
        },
        {
            "name": "Delete Inventory Item",
            "request": {
                "method": "DELETE",
                "header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
                "url": "http://localhost:5000/api/inventory/1"
            }
        },
        {
            "name": "Transfer Whole Pond",
            "request": {
                "method": "PUT",
                "header": [
                    {"key": "Authorization", "value": "Bearer {{auth_token}}"},
                    {"key": "Content-Type", "value": "application/json"}
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"fromPondId\": 1,\n    \"toPondId\": 2\n}"
                },
                "url": "http://localhost:5000/api/inventory/transfer-whole-pond"
            }
        }
    ]
},
{
