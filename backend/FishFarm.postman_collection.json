{
	"info": {
		"name": "Fish Farming Guide",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Signup",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fullName\": \"Ali Khan\",\n    \"email\": \"ali@farm.com\",\n    \"password\": \"secure123\",\n    \"farmName\": \"Indus Valley Fish\",\n    \"province\": \"Sindh\",\n    \"district\": \"Thatta\"\n}"
						},
						"url": "http://localhost:5000/api/auth/signup"
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.globals.set(\"auth_token\", jsonData.token);",
									"    pm.globals.set(\"user_id\", jsonData.user.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"ali@farm.com\",\n    \"password\": \"secure123\"\n}"
						},
						"url": "http://localhost:5000/api/auth/login"
					}
				}
			]
		},
        {
			"name": "2. Region Management",
			"item": [
				{
					"name": "Get All Regions",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
						"url": "http://localhost:5000/api/regions"
					}
				},
				{
					"name": "Get Region by ID",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
						"url": "http://localhost:5000/api/regions/1"
					}
				}
			]
		},



		{
    "name": "3. Farm Management",
    "item": [
        {
            "name": "Get My Farm Details",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" }
                ],
                "url": "http://localhost:5000/api/farm/my-farm"
            }
        },
        {
            "name": "Get Farm Area Usage",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" }
                ],
                "url": "http://localhost:5000/api/farm/area-usage",
                "description": "Calculates total vs used area and returns the remaining acreage and usage percentage."
            }
        },
        {
            "name": "Setup Farm",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"totalArea\": 15.5,\n    \"regionId\": 1\n}"
                },
                "url": "http://localhost:5000/api/farm/setup",
                "description": "Initializes the farm and auto-calculates a 10% Nursery Pond."
            }
        },
        {
            "name": "Update Farm Details",
            "request": {
                "method": "PUT",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"totalArea\": 20.0,\n    \"regionId\": 2\n}"
                },
                "url": "http://localhost:5000/api/farm/update",
                "description": "Updates total acreage or region. Backend will block updates if totalArea is less than current pond usage."
            }
        },
        {
            "name": "View Farm by ID",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" }
                ],
                "url": "http://localhost:5000/api/farm/view/{{farm_id}}",
                "description": "Admin/Owner view of a specific FarmId."
            }
        },
        {
            "name": "Delete Farm",
            "request": {
                "method": "DELETE",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" }
                ],
                "url": "http://localhost:5000/api/farm/{{farm_id}}",
                "description": "Removes farm record. Ensure all associated ponds are handled first based on your DB constraints."
            }
        }
    ]
},
		{
			"name": "4. Pond Management",
			"item": [
				{
					"name": "Get My Ponds",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
						"url": "http://localhost:5000/api/ponds"
					}
				},
				{
					"name": "Pond Advisor (Recommend)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
						"url": {
							"raw": "http://localhost:5000/api/ponds/recommend?acres=1.5&type=Concrete",
							"query": [
								{"key": "acres", "value": "1.5"},
								{"key": "type", "value": "Concrete"}
							]
						}
					}
				},
				{
    "name": "Add New Pond",
    "request": {
        "method": "POST",
        "header": [
            {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
            },
            {
                "key": "Content-Type",
                "value": "application/json"
            }
        ],
        "body": {
            "mode": "raw",
            "raw": "{\n    \"FarmId\": 1,\n    \"PondName\": \"Nursery Pond 2\",\n    \"Stage\": \"Nursery\",\n    \"CultureType\": \"Monoculture\",\n    \"PondType\": \"Earthen\",\n    \"Size\": 0.25,\n    \"CultivationType\": \"Intensive\",\n    \"LengthFeet\": null,\n    \"WidthFeet\": null,\n    \"DepthFeet\": 5.5,\n    \"VolumeLiters\": null\n}"
        },
        "url": {
            "raw": "http://localhost:5000/api/ponds",
            "protocol": "http",
            "host": [
                "localhost"
            ],
            "port": "5000",
            "path": [
                "api",
                "ponds"
            ]
        },
        "description": "RegionId is automatically inherited from the Farm. Dimensions (Length, Width, Volume) will be auto-calculated if sent as null."
    }
},
				{
					"name": "Update Pond",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}, {"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"PondName\": \"Updated Nursery A\",\n    \"Stage\": \"Grow-out\",\n    \"Size\": 2.0,\n    \"PondType\": \"Concrete\"\n}"
						},
						"url": "http://localhost:5000/api/ponds/1"
					}
				},
				{
					"name": "Delete Pond",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
						"url": "http://localhost:5000/api/ponds/1"
					}
				},{
    "name": "Get Pond Stats Summary",
    "request": {
        "method": "GET",
        "header": [
            {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
            }
        ],
        "url": {
            "raw": "http://localhost:5000/api/ponds/stats/summary",
            "protocol": "http",
            "host": [
                "localhost"
            ],
            "port": "5000",
            "path": [
                "api",
                "ponds",
                "stats",
                "summary"
            ]
        },
        "description": "Returns the total number of ponds and total acreage for the logged-in user (UserId 22)."
    }
}
			]
		},
		{
			"name": "5. Species Management",
			"item": [
				{
					"name": "Get All Species",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
						"url": "http://localhost:5000/api/species"
					}
				},
				{
					"name": "Add Custom Species",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"Name\": \"Rohu\",\n    \"ImageUrl\": \"https://example.com/rohu.jpg\",\n    \"MaxStockingDensity\": 12.0,\n    \"CompatibleRegions\": \"Punjab, Sindh\",\n    \"MinTemp\": 18,\n    \"MaxTemp\": 32,\n    \"MinPH\": 7.0,\n    \"MaxPH\": 8.5,\n    \"MinDO\": 5.0,\n    \"FingerlingSizeG\": 20,\n    \"MarketSizeKG\": 2.5,\n    \"HarvestTimeMonths\": 10\n}"
						},
						"url": "http://localhost:5000/api/species/add"
					}
				},
				{
					"name": "Check Compatibility",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
						"url": "http://localhost:5000/api/species/1/compatibility"
					}
				},
				{
					"name": "Ping Species Route",
					"request": {
						"method": "GET",
						"url": "http://localhost:5000/api/species/ping"
					}
				}
			]

		},
       {
    "name": "6. Stocking Operations",
    "item": [
        {
            "name": "Get Stocking Preview (Green Box Logic)",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" }
                ],
                "url": {
                    "raw": "http://localhost:5000/api/stocking/preview/:pondId/:speciesId?quantity=500",
                    "protocol": "http",
                    "host": ["localhost"],
                    "port": "5000",
                    "path": ["api", "stocking", "preview", ":pondId", ":speciesId"],
                    "query": [
                        { "key": "quantity", "value": "500", "description": "The amount the user is typing into the modal" }
                    ],
                    "variable": [
                        { "key": "pondId", "value": "1" },
                        { "key": "speciesId", "value": "2" }
                    ]
                },
                "description": "Calculates: \n1. Current fish in pond\n2. New total (Current + Quantity)\n3. Max capacity based on Pond Stage/Type\n4. Utilization %"
            }
        },
        {
            "name": "Get Stocking Inventory",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" }
                ],
                "url": "http://localhost:5000/api/stocking",
                "description": "Returns all stocking records owned by the authenticated user."
            }
        },
        {
            "name": "Add New Stock (Biological Advisor)",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"pondId\": 1,\n    \"speciesId\": 2,\n    \"quantity\": 400,\n    \"pricePerPiece\": 12.50,\n    \"currentSize\": 1.5,\n    \"targetSize\": 10.0,\n    \"stockingDate\": \"2026-02-08\"\n}"
                },
                "url": "http://localhost:5000/api/stocking/add",
                "description": "Finalizes stocking. Logic checks density, diversity, and feeding zones before inserting UserId."
            }
        },
        {
            "name": "Transfer Batch (Nursery to Grow-out)",
            "request": {
                "method": "PUT",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"stockId\": 1,\n    \"toPondId\": 2\n}"
                },
                "url": "http://localhost:5000/api/stocking/transfer",
                "description": "Updates CurrentPondId, Status, and RegionId. Restricted to records owned by UserId."
            }
        },
        {
            "name": "Update Growth Sampling",
            "request": {
                "method": "PUT",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"quantity\": 395,\n    \"currentSize\": 4.2,\n    \"targetSize\": 10.0\n}"
                },
                "url": "http://localhost:5000/api/stocking/:stockId",
                "variable": [
                    { "key": "stockId", "value": "1" }
                ]
            }
        },
        {
            "name": "Delete Stocking Record",
            "request": {
                "method": "DELETE",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{auth_token}}" }
                ],
                "url": "http://localhost:5000/api/stocking/:stockId",
                "variable": [
                    { "key": "stockId", "value": "1" }
                ]
            }
        }
    ]
},

		{
    "name": "7. Inventory Management",
    "item": [
        {
            "name": "Add Inventory Entry",
